# Copie para /opt/portfolio/.env na VPS e preencha os valores.

# Imagem publicada pelo GitHub Actions
APP_IMAGE=ghcr.io/sergiofisio/portifoliosergio:latest
# Porta local (só 127.0.0.1) onde o nginx vai buscar o app
APP_PORT=3020

# PostgreSQL (o container não expõe porta para fora)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE
POSTGRES_DB=portfolio

NEXT_PUBLIC_SITE_URL=https://devsergiofisico.com.br

# Auth.js — gere com: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=https://devsergiofisico.com.br/api/auth
# GitHub OAuth App — callback: https://devsergiofisico.com.br/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_LOGIN=sergiofisio

# Rode o seed só no primeiro deploy e depois volte para false
RUN_SEED=true

# Aviso por e-mail das mensagens de contato (opcional; sem SMTP elas ficam só em /admin/mensagens)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=sergiobastosfisio@gmail.com
