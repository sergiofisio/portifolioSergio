# Banco de dados (dev: docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public"

# URL pública do site (usada em SEO, sitemap e Auth.js)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js — gere com: npx auth secret  (ou: openssl rand -base64 33)
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Callback: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Login do GitHub com acesso ao /admin (separe vários com vírgula)
ADMIN_GITHUB_LOGIN="sergiofisio"

# Pasta onde os uploads do admin são gravados
UPLOAD_DIR="./uploads"

# Aviso por e-mail das mensagens de contato (opcional — sem SMTP elas ficam só em /admin/mensagens)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
CONTACT_TO_EMAIL="sergiobastosfisio@gmail.com"
